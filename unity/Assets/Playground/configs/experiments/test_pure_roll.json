{
  "meta": {
    "experimentName": "test_pure_roll",
    "notes": "Smoke test: pure roll, minimal pitch/heave, fixed seed, for throughput measurement"
  },
  "observation": {
    "enableCoMObservation": true,
    "enablePredictionObservation": false,
    "enableFeedforwardControl": true
  },
  "feedforward": {
    "K_roll": 0.1,
    "K_pitch": 0.1,
    "max_roll_comp": 8.0,
    "max_pitch_comp": 8.0,
    "support_threshold": 0.7,
    "filter_alpha": 0.3,
    "prediction_horizon": 0.1,
    "predictor_order": 2
  },
  "deckIMU": {
    "sensorMode": "Oracle",
    "angularVelocityNoise": 0.001,
    "accelerationNoise": 0.01,
    "attitudeNoise": 0.1,
    "sensorDelay": 0.01
  },
  "waveSpectrum": {
    "waveMode": "JONSWAP",
    "significantRollAmplitudeMin": 3.0,
    "significantRollAmplitudeMax": 3.0,
    "significantHeaveAmplitudeMin": 0.01,
    "significantHeaveAmplitudeMax": 0.01,
    "peakPeriodMin": 10.0,
    "peakPeriodMax": 10.0,
    "gamma": 3.3,
    "rollNaturalPeriodMin": 12.0,
    "rollNaturalPeriodMax": 12.0,
    "rollDampingRatioMin": 0.1,
    "rollDampingRatioMax": 0.1,
    "pitchNaturalPeriodMin": 7.0,
    "pitchNaturalPeriodMax": 7.0,
    "pitchDampingRatioMin": 0.15,
    "pitchDampingRatioMax": 0.15,
    "heaveNaturalPeriodMin": 6.0,
    "heaveNaturalPeriodMax": 6.0,
    "heaveDampingRatioMin": 0.3,
    "heaveDampingRatioMax": 0.3,
    "pitchScale": 0.01,
    "numComponents": 50,
    "omegaMin": 0.2,
    "omegaMax": 3.0,
    "waveSeed": 12345
  }
}
