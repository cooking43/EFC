{
  "meta": {
    "experimentName": "channel_knee_ankle_hip",
    "notes": "Ablation: Knee+Ankle+Hip roll compensation (M3 channel config)"
  },
  "observation": {
    "enableCoMObservation": true,
    "enablePredictionObservation": false,
    "enableFeedforwardControl": true
  },
  "feedforward": {
    "K_roll": 0.1,
    "K_pitch": 0.1,
    "max_roll_comp": 8,
    "max_pitch_comp": 8,
    "support_threshold": 0.7,
    "filter_alpha": 0.3,
    "prediction_horizon": 0.1,
    "predictor_order": 2,
    "enable_knee": true,
    "enable_ankle": true,
    "enable_hip": true
  },
  "deckIMU": {
    "sensorMode": "Oracle",
    "angularVelocityNoise": 0.001,
    "accelerationNoise": 0.01,
    "attitudeNoise": 0.1,
    "sensorDelay": 0.01
  },
  "waveSpectrum": {
    "waveMode": "JONSWAP",
    "significantRollAmplitudeMin": 2,
    "significantRollAmplitudeMax": 5,
    "significantHeaveAmplitudeMin": 0.1,
    "significantHeaveAmplitudeMax": 0.5,
    "peakPeriodMin": 6,
    "peakPeriodMax": 14,
    "gamma": 3.3,
    "rollNaturalPeriodMin": 8,
    "rollNaturalPeriodMax": 15,
    "rollDampingRatioMin": 0.05,
    "rollDampingRatioMax": 0.15,
    "pitchNaturalPeriodMin": 5,
    "pitchNaturalPeriodMax": 10,
    "pitchDampingRatioMin": 0.1,
    "pitchDampingRatioMax": 0.2,
    "heaveNaturalPeriodMin": 4,
    "heaveNaturalPeriodMax": 8,
    "heaveDampingRatioMin": 0.2,
    "heaveDampingRatioMax": 0.4,
    "pitchScale": 0.8,
    "numComponents": 50,
    "omegaMin": 0.2,
    "omegaMax": 3,
    "waveSeed": -1
  }
}
